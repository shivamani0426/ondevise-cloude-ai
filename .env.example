# Firebase web config is public application metadata, not an admin secret.
# Fill through Render Static Site > Environment or local .env.local.
# Do not copy an App Check DEBUG TOKEN into a public VITE_ variable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=phantomgraph-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=phantomgraph-ai
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
